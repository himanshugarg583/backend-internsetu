NODE_ENV=development
PORT=4000
# PostgreSQL / Docker Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=internsetu
POSTGRES_PORT=5433

# Database URL:
# For local dev outside Docker (connects to localhost:5433 mapped by Docker):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/internsetu?schema=public"
# Optional: Override DATABASE_URL for Docker container if needed:
# DOCKER_DATABASE_URL="postgresql://postgres:postgres@postgres:5432/internsetu?schema=public"
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false

STORAGE_ROOT=./storage
OFFER_LETTER_TEMPLATE=offer-letter.txt
CERTIFICATE_TEMPLATE=certificate.txt

# SMTP (if SMTP_HOST is empty, emails are NOT delivered; a JSON transport is used and a warning is logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="InternSetu <no-reply@internsetu.in>"
# Optional fallback sender used when SMTP_FROM is empty
SMTP_BACKUP_FROM=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: if empty, the webhook is disabled and POST /payments/verify confirms payments
RAZORPAY_WEBHOOK_SECRET=

# Business config (server-trusted)
CERTIFICATE_BASE_FEE=499
GST_PERCENT=18
CURRENCY=INR
INTERN_ID_PREFIX=ISX
ALLOWED_DURATIONS_WEEKS=2,4,6,8
CERTIFICATE_MIN_PROGRESS=50
